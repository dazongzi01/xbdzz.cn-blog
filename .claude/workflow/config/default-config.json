{
  "system": {
    "name": "Article Writing Automation Workflow",
    "version": "1.0.0",
    "author": "Claude Code",
    "description": "Automated article writing system with 5-phase workflow"
  },
  "phases": {
    "phase1": {
      "name": "Content Planning",
      "duration": "1 hour",
      "description": "Analyze content structure and plan content organization",
      "script": "phase1-plan.py",
      "enabled": true
    },
    "phase2": {
      "name": "Initial Draft Generation",
      "duration": "4-8 hours",
      "description": "Generate comprehensive initial draft using Claude API",
      "script": "phase2-draft.py",
      "enabled": true,
      "critical": true
    },
    "phase3": {
      "name": "Illustration Guidelines",
      "duration": "1 hour",
      "description": "Generate detailed illustration guidelines",
      "script": "phase3-illustrations.py",
      "enabled": true
    },
    "phase4": {
      "name": "Format Optimization",
      "duration": "45 minutes",
      "description": "Check formatting and generate optimization checklist",
      "script": "phase4-format.py",
      "enabled": true
    },
    "phase5": {
      "name": "Publishing Checklist",
      "duration": "1 hour",
      "description": "Final quality check and publishing preparation",
      "script": "phase5-publish.py",
      "enabled": true
    }
  },
  "writing": {
    "default_style": "俏皮有趣，专业准确",
    "default_audiences": ["技术人员", "运营人员", "产品经理"],
    "target_word_count": 5000,
    "required_illustrations": 4,
    "quality_score_threshold": 85
  },
  "output": {
    "formats": ["markdown", "html"],
    "publish_directory": "docs/01_初步了解",
    "archive_old_versions": true
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_retention_days": 30
  },
  "api": {
    "provider": "anthropic",
    "model": "claude-3-5-sonnet-20241022",
    "timeout": 300,
    "retry_attempts": 3
  }
}
